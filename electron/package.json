{
  "name": "ugesture-ui",
  "version": "1.0.0",
  "description": "UGesture - Hand Gesture Control Desktop App",
  "main": "main.js",

  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },

  "author": "V Adhithyan",
  "license": "MIT",

  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.8.1"
  },

  "build": {
    "appId": "com.adhi.ugesture",
    "productName": "UGesture",

    "directories": {
      "output": "dist"
    },

    "files": [
      "**/*"
    ],

    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}